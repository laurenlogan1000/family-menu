    "baked-cod-cracker": {
      "id": "baked-cod-cracker",
      "title": "<a href=\"https://cooking.nytimes.com/recipes/1022936-baked-cod-with-buttery-cracker-topping\">Baked Cod With Buttery Cracker Topping</a> + rice + <a href=\"https://cooking.nytimes.com/recipes/1015707-lemon-garlic-kale-salad\">Lemon-Garlic Kale Salad</a>",
