    "mami-flank-steak": {
      "id": "mami-flank-steak",
      "title": "Mami’s Flank Steak + couscous + <a href=\"https://cooking.nytimes.com/recipes/1014449-julienne-carrot-salad\">Julienne Carrot Salad</a>",
      "do": "Heat broiler or grill. Pull steak from marinade; pat dry. Cook 5–6 min per side to 130°; rest 10 min; slice thin across the grain. Couscous: boil 1¼ cups water + butter + salt; stir in couscous; cover 5 min; fluff. Julienne carrots; salt. Stir shallot, lemon juice, garlic, olive oil, salt, pepper; toss with carrots; rest 5–10 min. Chives.",
