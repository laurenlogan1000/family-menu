    "grilled-chicken-skewers": {
      "id": "grilled-chicken-skewers",
      "title": "<a href=\"https://cooking.nytimes.com/recipes/1021082-grilled-chicken-skewers-with-tarragon-and-yogurt\">Grilled Chicken Skewers With Tarragon and Yogurt</a> + pita + grilled veggie skewers",
      "do": "Pull chicken 1 hr before; soak wooden skewers 15 min. Thread chicken; thread zucchini, red bell pepper, red onion on separate skewers; oil + salt. Grill chicken over high heat 3–5 min until it releases; flip. Melt butter + salt; add lime juice + tarragon; baste chicken; grill scallions + veggie skewers alongside 8 min until chicken is cooked through. Grill pitas 1 min; top with chicken, scallions, herb butter, reserved yogurt, lime, more herbs.",
      "well": "4",
      "protein": "chicken",
      "prep": [
